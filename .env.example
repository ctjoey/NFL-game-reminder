# Copy to .env (or export in your shell). All optional.
PORT=3000
# Public base URL used in emails / calendar links
BASE_URL=http://localhost:3000
# Web Push (generate with: npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional: Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional: live schedule source. "espn" (default) or "seed" (offline)
SCHEDULE_SOURCE=espn
# How often to re-sync the schedule (minutes)
SYNC_INTERVAL_MIN=15
